{
  // ROS2 Hero lab — เดสก์ท็อป Ubuntu ในเบราว์เซอร์ + ROS 2 Jazzy + TurtleBot3
  // เปิดใน GitHub Codespaces: กดปุ่ม "เปิด lab" ในบทเรียนบน ros2hero.allmobilerobotics.com
  "name": "ROS2 Hero lab (ROS 2 Jazzy + TurtleBot3)",
  "image": "tiryoh/ros2-desktop-vnc:jazzy",
  "runArgs": ["--shm-size=1g"],
  // เดสก์ท็อปเปิดที่พอร์ต 6080 โดย start-desktop.sh (ไม่ใช้ 80 — ดูเหตุผลในไฟล์นั้น)
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": { "label": "เดสก์ท็อป ROS 2 (เปิดอันนี้)", "onAutoForward": "openBrowser" }
  },
  "otherPortsAttributes": { "onAutoForward": "ignore" },
  "remoteUser": "root",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start-desktop.sh",
  "hostRequirements": { "cpus": 2, "memory": "8gb" }
}
